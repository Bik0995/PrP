    <string name="proprio_attente">Meanwhile, browser filtering works, but it can be turned off.</string>
    <string name="detection_titre">Image detection</string>
    <string name="detection_texte">Masks exposed areas on screen, in every app. Everything is analysed on the phone: no image is stored or sent.</string>
    <string name="detection_android11">Requires Android 11 or newer. Site blocking still works.</string>
