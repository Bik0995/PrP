    <string name="garde_nom">PrP – Guard</string>
    <string name="garde_description">Reads the address shown by browsers to block adult sites and masks explicit images on screen. Nothing is stored or sent: everything happens on the phone.</string>
    <string name="sous_titre">Adult content blocker, locked in time</string>
    <string name="essai_titre">Trial version</string>
